# KernelSU Next legacy for the 4.14.113 Exynos 9825 kernel.
# Use manual hooks on this old non-GKI kernel; the legacy Kprobe hook
# explicitly warns against kernels below 5.10.
CONFIG_OVERLAY_FS=y
CONFIG_KSU=y
CONFIG_KSU_MANUAL_HOOK=y
CONFIG_KSU_ALLOWLIST_WORKAROUND=y
CONFIG_ANDROID_SAR_RAMDISK=y
CONFIG_ANDROID_BOOT_PARTITION="/dev/sda14"
