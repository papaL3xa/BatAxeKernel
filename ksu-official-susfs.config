# Experimental: official KernelSU v0.9.5 + SUSFS 1.5.12
# This config is usable only after BOTH Exynos 9825/4.14.113 patches are supplied
# and verified in patches/susfs-1.5.12/.
CONFIG_OVERLAY_FS=y
CONFIG_KSU=y
CONFIG_KPROBES=y
CONFIG_HAVE_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_KSU_SUSFS=y
CONFIG_ANDROID_SAR_RAMDISK=y
CONFIG_ANDROID_BOOT_PARTITION="/dev/sda14"
